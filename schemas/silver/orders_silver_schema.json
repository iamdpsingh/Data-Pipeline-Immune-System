{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrdersSilverRecord",
  "description": "Silver layer conformed and validated orders table schema",
  "type": "object",
  "required": ["order_id", "customer_id", "order_date", "status", "total_amount_usd", "items_count", "_processed_at", "_run_id"],
  "properties": {
    "order_id": { "type": "string" },
    "customer_id": { "type": "string" },
    "order_date": { "type": "string", "format": "date" },
    "order_timestamp": { "type": "string", "format": "date-time" },
    "status": { "type": "string" },
    "total_amount_usd": { "type": "number", "minimum": 0.01 },
    "original_currency": { "type": "string" },
    "items_count": { "type": "integer", "minimum": 1 },
    "_processed_at": { "type": "string", "format": "date-time" },
    "_run_id": { "type": "string" }
  }
}
