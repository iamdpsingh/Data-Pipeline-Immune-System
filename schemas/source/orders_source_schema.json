{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrdersSourceRecord",
  "description": "Expected incoming record schema for the upstream e-commerce orders feed",
  "type": "object",
  "required": ["order_id", "customer_id", "order_date", "status", "total_amount", "currency"],
  "properties": {
    "order_id": {
      "type": "string",
      "pattern": "^ORD-[0-9]{8}-[0-9]{4}$",
      "description": "Unique identifier for the order"
    },
    "customer_id": {
      "type": "string",
      "pattern": "^CUST-[0-9]{6}$",
      "description": "Unique customer account reference"
    },
    "order_date": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the order was placed"
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "PROCESSING", "COMPLETED", "CANCELLED", "REFUNDED"],
      "description": "Lifecycle state of the order"
    },
    "total_amount": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100000.0,
      "description": "Gross transactional amount in designated currency"
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3,
      "description": "ISO-4217 three-letter currency code (e.g. USD, EUR)"
    },
    "items_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "description": "Total quantity of items in the order"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Upstream extraction audit timestamp"
    }
  },
  "additionalProperties": false
}
