{
  "title": "InventorySourcePayload",
  "type": "object",
  "required": [
    "sku",
    "warehouse_id",
    "quantity_on_hand",
    "updated_at"
  ],
  "properties": {
    "sku": {
      "type": "string"
    },
    "warehouse_id": {
      "type": "string"
    },
    "quantity_on_hand": {
      "type": "integer",
      "minimum": 0
    },
    "quantity_reserved": {
      "type": "integer",
      "minimum": 0
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
