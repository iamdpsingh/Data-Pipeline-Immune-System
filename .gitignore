# Data Pipeline Immune System — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
dashboard/telemetry.json

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Secrets & Credentials — strictly forbidden in git
*.env
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.crt
*_rsa
id_rsa*
secrets.yaml
secrets.yml
*service_account*.json
*credential*.json
*credentials*.json
gcloud-service-key.json
application_default_credentials.json

# Whitelist schema definitions
!schemas/**/*.json

# Terraform state — state should be in remote backend, not git
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl
terraform.tfvars    # may contain sensitive values

# GCP-specific
gcloud-service-key.json
application_default_credentials.json

# Logs
*.log
logs/

# Test artifacts
.pytest_tmp/
test-results/
coverage.xml

# Spark
derby.log
metastore_db/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Distribution
*.tar.gz
*.zip
