# ==============================================================================
# Data Pipeline Immune System — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the project root:
#    cp .env.example .env
# 2. Fill in your real credentials below.
# 3. The '.env' file is strictly git-ignored and will NEVER be pushed to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud Platform (GCP)
# ------------------------------------------------------------------------------
# GCP Project ID created in Google Cloud Console
GCP_PROJECT=data-pipeline-immune-system
GCP_REGION=us-central1

# Local path to your GCP credentials JSON (if not using 'gcloud auth application-default login')
# Run 'gcloud auth application-default login' in terminal to automatically generate this on your Mac.
GOOGLE_APPLICATION_CREDENTIALS=/Users/dhruvpratapsingh/.config/gcloud/application_default_credentials.json

# ------------------------------------------------------------------------------
# 2. Daily Email Executive Reports (100% Free via Gmail SMTP)
# ------------------------------------------------------------------------------
# Default destination for automated daily reports
DAILY_REPORT_RECIPIENT=dhruvpratapsingh30.official2.o@gmail.com

# Gmail SMTP Server settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_SENDER=

# HOW TO GET GMAIL APP PASSWORD (DO NOT USE YOUR REGULAR GMAIL PASSWORD):
# 1. Go to: https://myaccount.google.com/security
# 2. Ensure "2-Step Verification" is turned ON.
# 3. Search or navigate to "App Passwords" (https://myaccount.google.com/apppasswords).
# 4. Create an app named "Data Pipeline Immune System".
# 5. Copy the 16-character generated password (e.g. abcd efgh ijkl mnop) and paste below:
SMTP_PASSWORD=YOUR_16_CHAR_GMAIL_APP_PASSWORD

# ------------------------------------------------------------------------------
# 3. Hourly Mobile Notifications (100% Free Options — No Twilio)
# ------------------------------------------------------------------------------
# Recipient mobile phone with international country code (e.g., +91 for India)
WHATSAPP_RECIPIENT=+919876543210

# OPTION A: Meta WhatsApp Cloud API (Official Free Tier — 1,000 free conversations/mo)
# HOW TO GET:
# 1. Go to Meta Developers: https://developers.facebook.com/
# 2. Create an App -> Select "Other" -> Type "Business" -> Add "WhatsApp" product.
# 3. In WhatsApp > API Setup: Copy the "Temporary access token" and "Phone number ID".
WHATSAPP_API_TOKEN=YOUR_META_WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_META_PHONE_NUMBER_ID

# OPTION B: Telegram Bot API (100% Free Forever — Instant Phone Push Notifications)
# HOW TO GET (EASIEST, Takes 1 minute):
# 1. Open Telegram app on phone and search for "@BotFather".
# 2. Send command: /newbot
# 3. Name your bot (e.g. DPIS_Alert_Bot) and copy the HTTP API token below.
# 4. Search for "@userinfobot" in Telegram and send /start to get your numeric Chat ID.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# OPTION C: ntfy.sh (100% Free Open-Source Push Notifications to Phone — Zero Signup)
# HOW TO GET:
# 1. Download "ntfy" app from App Store (iOS) or Google Play (Android).
# 2. Subscribe to any unique topic name in the app (e.g., "dpis-alerts-dpsingh").
# 3. Set ENABLE_NTFY_PUSH=true below.
ENABLE_NTFY_PUSH=false
NTFY_TOPIC=dpis-alerts-dpsingh

# OPTION D: Free Webhook (Discord / Slack / Google Chat)
ALERT_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 4. Autonomous AI Diagnosis Agent (Gemini 1.5)
# ------------------------------------------------------------------------------
# HOW TO GET FREE GEMINI API KEY:
# 1. Go to Google AI Studio: https://aistudio.google.com/app/apikey
# 2. Click "Create API Key" (Free tier available).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ------------------------------------------------------------------------------
# 5. Environment & Service Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=dev
CLOUD_RUN_URL=https://dpis-api.internal
